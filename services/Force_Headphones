#!/bin/bash

SINK="alsa_output.pci-0000_00_1f.3.analog-stereo"

case "$1" in
    start)
        # Wait for PipeWire/Pulse compatibility layer to be ready
        for i in $(seq 1 10); do
            if pactl set-sink-port "$SINK" analog-output-headphones 2>/dev/null; then
                exit 0
            fi
            sleep 1
        done
        exit 1
        ;;
    stop)
        exit 0
        ;;
    status)
        pactl list sinks | grep "Active Port"
        ;;
esac
